#include <stdio.h>

  int main(){
    int i, n;
    long long fatorial = 1;

    printf("Digite um numero: ");
    scanf("%d", &n);

    if(n < 0){
        printf("Numero negativo nao tem fatorial!\n");
    } else {
        for(i = 1; i <= n; i++){
            fatorial = fatorial * i;
        }
        printf("Fatorial de %d = %lld\n", n, fatorial);
    }

    return 0;
}
