#include <stdio.h>

    int main(){
    int i, j;
    float notas[4][4];
    float media;

    for(i = 0; i < 4; i++){
        printf("\nAluno %d:\n", i + 1);
        for(j = 0; j < 4; j++){
            printf("  Digite a nota %d: ", j + 1);
            scanf("%f", &notas[i][j]);
        }
    }

    printf("\n");

    for(i = 0; i < 4; i++){
        media = 0;
        for(j = 0; j < 4; j++){
            media = media + notas[i][j];
        }
        media = media / 4;
        printf("Media do aluno %d: %.2f\n", i + 1, media);
    }

    return 0;
}
